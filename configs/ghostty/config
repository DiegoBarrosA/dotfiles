# Ghostty Configuration - Material Darker Theme

# Shell
command = /home/diego/.nix-profile/bin/nu
shell-integration = none
confirm-close-surface = false

# Font Configuration
font-family = "FantasqueSansM Nerd Font"
font-size = 20
font-feature = -calt

# Window Configuration
window-padding-x = 15
window-padding-y = 15
window-decoration = true

# Cursor
cursor-style = bar
cursor-style-blink = true

# Mouse
mouse-hide-while-typing = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# Scrollback
scrollback-limit = 10000

# Material Darker Theme Colors
background = 212121
foreground = eeffff

# Cursor colors
cursor-color = eeffff
cursor-text = 212121

# Selection colors
selection-background = 82aaff
selection-foreground = 212121

# Normal colors
palette = 0=#212121
palette = 1=#f07178
palette = 2=#c3e88d
palette = 3=#ffcb6b
palette = 4=#82aaff
palette = 5=#c792ea
palette = 6=#89ddff
palette = 7=#eeffff

# Bright colors
palette = 8=#4a4a4a
palette = 9=#f07178
palette = 10=#c3e88d
palette = 11=#ffcb6b
palette = 12=#82aaff
palette = 13=#c792ea
palette = 14=#89ddff
palette = 15=#ffffff

# Keybindings
keybind = super+shift+f=toggle_fullscreen
