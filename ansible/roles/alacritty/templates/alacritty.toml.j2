# Alacritty Configuration - Material Darker Theme
# Generated by Ansible

[env]
TERM = "xterm-256color"

[window]
decorations = "none"
dynamic_padding = true
opacity = 0.95
padding = { x = 15, y = 15 }

[font]
size = {{ theme.fonts.sizes.terminal }}

[font.normal]
family = "{{ theme.fonts.monospace }}"
style = "Regular"

[font.bold]
family = "{{ theme.fonts.monospace }}"
style = "Bold"

[font.italic]
family = "{{ theme.fonts.monospace }}"
style = "Italic"

# Material Darker Colors
[colors.primary]
background = "#{{ theme.colors.base00 }}"
foreground = "#{{ theme.colors.base05 }}"

[colors.cursor]
cursor = "#{{ theme.colors.base0D }}"
text = "#{{ theme.colors.base00 }}"

[colors.vi_mode_cursor]
cursor = "#{{ theme.colors.base0E }}"
text = "#{{ theme.colors.base00 }}"

[colors.selection]
background = "#{{ theme.colors.base02 }}"
text = "#{{ theme.colors.base05 }}"

[colors.normal]
black   = "#{{ theme.colors.base00 }}"
red     = "#{{ theme.colors.base08 }}"
green   = "#{{ theme.colors.base0B }}"
yellow  = "#{{ theme.colors.base0A }}"
blue    = "#{{ theme.colors.base0D }}"
magenta = "#{{ theme.colors.base0E }}"
cyan    = "#{{ theme.colors.base0C }}"
white   = "#{{ theme.colors.base05 }}"

[colors.bright]
black   = "#{{ theme.colors.base03 }}"
red     = "#{{ theme.colors.base08 }}"
green   = "#{{ theme.colors.base0B }}"
yellow  = "#{{ theme.colors.base0A }}"
blue    = "#{{ theme.colors.base0D }}"
magenta = "#{{ theme.colors.base0E }}"
cyan    = "#{{ theme.colors.base0C }}"
white   = "#{{ theme.colors.base07 }}"

[selection]
save_to_clipboard = true

[cursor]
style = { shape = "Beam", blinking = "On" }
blink_interval = 500
unfocused_hollow = true

[mouse]
hide_when_typing = true

[scrolling]
history = 10000
multiplier = 3

[keyboard]
# Note: Keybindings can be added here if needed
