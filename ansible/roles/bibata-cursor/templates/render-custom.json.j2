{
  "{{ bibata_cursor_name }}": {
    "dir": "svg/modern",
    "out": "bitmaps/{{ bibata_cursor_name }}",
    "colors": [
      { "match": "#00FF00", "replace": "{{ bibata_colors.base }}" },
      { "match": "#0000FF", "replace": "{{ bibata_colors.outline }}" },
      
      { "match": "#FF0000", "replace": "#ff5370" },
      { "match": "#FE0000", "replace": "#ff5370" },
      
      { "match": "#96C865", "replace": "#c3e88d" },
      { "match": "#06B231", "replace": "#c3e88d" },
      
      { "match": "#FDBE2A", "replace": "#ffcb6b" },
      
      { "match": "#F27400", "replace": "#f78c6c" },
      
      { "match": "#F1613A", "replace": "#f07178" },
      
      { "match": "#5F3BE4", "replace": "#c792ea" },
      
      { "match": "#4FADDF", "replace": "#89ddff" },
      { "match": "#0A6857", "replace": "#89ddff" },
      
      { "match": "#179DD8", "replace": "#82aaff" },
      
      { "match": "#2C2C2C", "replace": "#303030" },
      { "match": "#606060", "replace": "#4a4a4a" }
    ]
  }
}
